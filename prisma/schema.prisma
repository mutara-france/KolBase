// KolBase — modèle de données initial
// Dérivé du prototype « KolBase plateforme » (rôles, dossiers, événements, hospitalités).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Comptes ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("fr")
  notifyPrefs  Json      @default("{}")
  emailVerifiedAt DateTime? // adresse confirmée par le lien reçu par e-mail
  followsSeenAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  practitioner  PractitionerProfile?
  memberships   Membership[]
  registrations Registration[]
  messages      Message[]
  rfqMessages   RfqMessage[]
  supplierReviews SupplierReview[]
  auditLogs     AuditLog[]
  sessions      Session[]
  invitationsSent     Invitation[] @relation("invitedBy")
  invitationsAccepted Invitation[] @relation("acceptedBy")
  follows             Follow[]
  authTokens          AuthToken[]
}

enum AuthTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
}

// Jeton à usage unique envoyé par e-mail (réinitialisation du mot de passe, confirmation d'adresse) : seul son hash est stocké.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId])
}

// Suivi d'un expert ou d'une organisation : alimente le fil « Mes suivis ».
model Follow {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  practitionerId String?
  practitioner   PractitionerProfile? @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  @@unique([userId, practitionerId])
  @@unique([userId, organizationId])
}

// Session de connexion : seul le hash du jeton est stocké.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Un praticien a toujours un profil ; il devient KOL quand il se référence (listed = true).
model PractitionerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession    String
  rpps          String?  @unique
  rppsVerified  Boolean  @default(false) // identité vérifiée par KolBase (RPPS en France, identifiant du pays sinon)
  country       String   @default("FR")  // pays d'exercice principal (code ISO, « XX » : autre pays)
  licenseNumber String?                  // hors France : identifiant professionnel (INAMI, NPI, n° d'Ordre…)
  city          String?
  hospital      String?
  specialty     String?
  subspecialty  String?
  languages     String[]
  interventionTypes String[]
  dayRateCents  Int?
  orcid         String?
  bio           String?
  responseDays  Int?
  listed        Boolean  @default(false) // référencé comme expert (KOL)
  listedAt      DateTime?
  visibility    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  structures    PractitionerStructure[]
  declaredInterests DeclaredInterest[]
  publications  Publication[]
  projectLinks  ProjectExpert[]
  applications  Application[]
  followers     Follow[]
  orcidSyncedAt DateTime?
  orcidVerified Boolean   @default(false) // iD obtenu par connexion au compte ORCID
  rppsCheckedAt DateTime? // contrôle du RPPS par un administrateur KolBase (validé ou refusé)
  rppsCheckNote String?   // motif d'un refus
  // Coordonnées de facturation (notes d'honoraires) : société d'exercice éventuelle, adresse, SIRET, TVA, IBAN.
  billingEntity  String?
  billingAddress String?
  siret          String?
  vatRegime      String   @default("franchise") // franchise (art. 293 B du CGI) ou assujetti
  vatNumber      String?
  iban           String?
  feeNotes       FeeNote[]
}

// Publication scientifique déclarée par le praticien.
model Publication {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title          String
  journal        String?
  year           Int?
  doi            String?
  keywords       String[]
  source         String?             // orcid si importée
  createdAt      DateTime            @default(now())

  @@index([practitionerId])
}

// Structure d'exercice / de facturation du praticien (SELARL, SCM…).
model PractitionerStructure {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  name           String
  legalForm      String
  siren          String?
  role           String?
  sharePercent   Int?
  isPayee        Boolean             @default(false)
  since          DateTime?
}

// Lien d'intérêts noué hors de KolBase, déclaré par le praticien (complète sa déclaration de liens d'intérêts).
model DeclaredInterest {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  organization   String
  nature         String
  startYear      Int
  endYear        Int?
  createdAt      DateTime            @default(now())

  @@index([practitionerId])
}

// Validation des organisations par KolBase (SIREN contrôlé, puis validation par un administrateur).
enum OrgVerification {
  PENDING
  VERIFIED
  REJECTED
}

enum OrgKind {
  INDUSTRIEL
  SOCIETE_SAVANTE
  ASSOCIATION_PRO
  ORGANISME_FORMATION
  PRESTATAIRE
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  kind         OrgKind
  sector       String?
  headquarters String?
  size         String?
  areas        String[]
  about        String?
  policy       String?
  contactEmail String?
  responseDays Int?
  listed       Boolean  @default(false)
  visibility   Json     @default("{}")
  complianceSettings Json @default("{}")
  // Prestataires référencés : catégories de prestation et zone couverte.
  supplierCategories String[] @default([])
  coverage           String?
  // Book prestataire : capacités ({ seats, cocktail, banquet, rooms }), équipements, accessibilité, prix indicatif.
  capacities         Json     @default("{}")
  equipment          String[] @default([])
  accessible         Boolean  @default(false)
  priceHint          String?
  // Identité légale et validation par KolBase.
  siren              String?
  legalName          String?          // dénomination officielle (API Recherche d'entreprises)
  sirenActive        Boolean?         // entreprise active selon l'API (null : contrôle impossible)
  sirenCheckedAt     DateTime?
  verification       OrgVerification  @default(PENDING)
  verifiedAt         DateTime?
  verifiedById       String?
  verificationNote   String?
  // Logo (image stockée à part, servie par /logos/[id]) : date de mise à jour, null si aucun logo.
  logoUpdatedAt      DateTime?
  // Contrat de sous-traitance (RGPD, art. 28) accepté au nom de l'organisation : version, date, administrateur.
  dpaVersion         String?
  dpaAcceptedAt      DateTime?
  dpaAcceptedById    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logo          OrganizationLogo?
  feeNotes      FeeNote[]
  photos        OrganizationPhoto[]
  offers        SupplierOffer[]
  reviewsReceived SupplierReview[] @relation("reviewSupplier")
  reviewsGiven    SupplierReview[] @relation("reviewClient")
  members       Membership[]
  projects      Project[]
  events        Event[]       @relation("orgEvents")
  openCalls     OpenCall[]
  // Mandats : une organisation peut mandater un prestataire.
  mandatesGiven    Mandate[] @relation("mandator")
  mandatesReceived Mandate[] @relation("agency")
  invitations      Invitation[]
  rfqs             Rfq[]         @relation("rfqRequester")
  rfqInvites       RfqSupplier[]
  quotes           Quote[]
  rfqMessages      RfqMessage[]
  followers        Follow[]
  agencyEvents     Event[]       @relation("agencyEvents")
}

// Invitation d'un membre par lien (jeton à usage unique, stocké haché).
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  email          String?
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("invitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?        @relation("acceptedBy", fields: [acceptedById], references: [id])
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
}

// Rôles côté organisation (cf. ROLE_LABEL du prototype).
enum OrgRole {
  ADMIN          // équipe, fiche et réglages ; accès à tout
  PROJETS        // experts, dossiers, événements, prestataires (ex-Éducation, Événements)
  CONFORMITE     // validation, relecture des supports, déclarations (ex-Conformité, Relecture)
  PRESTATAIRE    // client : agence mandatée (événements confiés) ; prestataire : membre de l'équipe
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId, role])
}

model Mandate {
  id         String       @id @default(cuid())
  mandatorId String
  mandator   Organization @relation("mandator", fields: [mandatorId], references: [id])
  agencyId   String
  agency     Organization @relation("agency", fields: [agencyId], references: [id])
  scope      String?
  startsAt   DateTime     @default(now())
  endsAt     DateTime?
}

// ─── Dossiers (collaborations praticien ↔ organisation) ────────────────────

enum ProjectStatus {
  ATT_EXPERTS   // En attente des experts
  ATT_IND       // En attente de l'organisation
  ACCORD        // Accord de principe
  EN_VALID      // En validation conformité
  BLOQUE        // Bloqué par la conformité
  VALIDE        // Validé par la conformité
  ORDRE         // Autorisation de l'Ordre en cours
  REFUS_ORDRE   // Autorisation refusée
  SIGNATURE     // En signature
  SIGNE         // Signé
  TERMINE       // Terminé
  DECLINE       // Décliné
}

model Project {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  title           String
  typeId          String
  therapeuticArea String?
  origin          String?
  description     String?
  status          ProjectStatus @default(ATT_EXPERTS)
  declared        Boolean       @default(false)
  complianceNote  String?
  ordreRef        String?
  createdById     String?
  budgetCents     Int?
  declarationRef  String?   // référence de publication Transparence Santé
  declaredAt      DateTime?
  // Signature attestée sans convention déposée (stockage de documents non configuré) : qui et quand.
  signatureAttestedAt   DateTime?
  signatureAttestedById String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  experts   ProjectExpert[]
  documents Document[]
  messages  Message[]
  expenses  Expense[]
  events    Event[]
  materials Material[]
}

// Support (diaporama, article, vidéo…) soumis à relecture médico-réglementaire.
model Material {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  kind      String   // diaporama, article, video, autre
  createdAt DateTime @default(now())

  versions MaterialVersion[]
}

model MaterialVersion {
  id            String    @id @default(cuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  version       Int
  url           String?
  notes         String?
  status        ReviewStatus @default(submitted)
  submittedById String
  reviewerId    String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([materialId, version])
}

model ProjectExpert {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  status         ProjectStatus       @default(ATT_EXPERTS)
  feeCents       Int?                // honoraires totaux proposés (€ HT, en centimes)
  days           Float?              // nombre d'unités (journées, interventions…)
  responseNote   String?
  respondedAt    DateTime?
  // Paiement des honoraires, indiqué par l'organisation (visible de l'expert dans « Mes revenus »).
  paidAt         DateTime?
  paidCents      Int?
  createdAt      DateTime            @default(now())

  messages  Message[]
  documents Document[]
  signature ConventionSignature?
  feeNote   FeeNote?

  @@unique([projectId, practitionerId])
}

// Statut d'une demande de signature électronique (valeurs du prestataire, Yousign).
enum SignatureStatus {
  draft
  ongoing
  done
  declined
  expired
  canceled
}

// Signature électronique (Yousign) de la convention d'un expert. Une seule demande suivie par expert :
// un nouvel envoi (après refus, expiration ou annulation) remplace la précédente ; l'historique est dans AuditLog.
model ConventionSignature {
  id              String          @id @default(cuid())
  projectExpertId String          @unique
  projectExpert   ProjectExpert   @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  requestId       String          @unique // identifiant de la demande chez le prestataire
  documentId      String?         // identifiant du document à signer chez le prestataire
  status          SignatureStatus @default(draft)
  sentById        String?         // signataire côté organisation (auteur de l'envoi)
  sentAt          DateTime?
  completedAt     DateTime?
  note            String?         // motif d'un refus, échec de l'envoi
  updatedAt       DateTime        @updatedAt
}

// Pièce d'un dossier, stockée dans le stockage objet (S3 compatible) : convention signée d'un expert ou autre pièce.
enum DocumentKind {
  CONVENTION_SIGNEE
  PIECE
}

model Document {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Expert concerné (convention signée, pièce qui le concerne) : il voit et télécharge le document.
  projectExpertId String?
  projectExpert   ProjectExpert? @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  kind            DocumentKind   @default(PIECE)
  name            String         // nom du fichier déposé
  contentType     String
  size            Int
  storageKey      String         @unique
  uploadedById    String?
  createdAt       DateTime       @default(now())

  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Fil de discussion entre l'organisation et un expert donné.
  projectExpertId String?
  projectExpert   ProjectExpert? @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  date        DateTime
  status      ExpenseStatus @default(draft)
}

// ─── Événements, inscriptions, hospitalités ────────────────────────────────

enum EventFormat {
  PRESENTIEL
  DISTANCIEL
  HYBRIDE
}

model Event {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation("orgEvents", fields: [organizationId], references: [id])
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id])
  title            String
  typeId           String
  therapeuticArea  String?
  description      String?
  startsAt         DateTime
  durationMinutes  Int?
  format           EventFormat  @default(PRESENTIEL)
  city             String?
  venue            String?
  capacity         Int?
  registrationOpen Boolean      @default(true)
  publishedAt      DateTime?
  // Réunion interne (board, comité…) : ni publication dans l'agenda, ni inscriptions en ligne.
  internal         Boolean      @default(false)
  program          String?      // programme scientifique (déroulé horaire), affiché sur la page publique
  // Agence prestataire mandatée : ses membres (rôle Prestataire) ne voient que les événements confiés.
  agencyId         String?
  agency           Organization? @relation("agencyEvents", fields: [agencyId], references: [id])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  benefits      EventBenefit[]
  registrations Registration[]
  surveys       SurveyResponse[]
  rfqs          Rfq[]
  calls         OpenCall[]
}

// Demande de devis adressée à des prestataires référencés.
model Rfq {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("rfqRequester", fields: [organizationId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  category       String
  city           String?
  headcount      Int?
  needs          String
  deadline       DateTime?
  status         RfqStatus    @default(draft)
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  suppliers RfqSupplier[]
  quotes    Quote[]
  messages  RfqMessage[]
  review    SupplierReview?
}

// Questions et échanges sur une demande de devis : un fil privé entre le demandeur et chaque prestataire consulté.
model RfqMessage {
  id         String       @id @default(cuid())
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Organization @relation(fields: [supplierId], references: [id])
  authorId   String
  author     User         @relation(fields: [authorId], references: [id])
  fromSupplier Boolean    @default(false) // écrit par le prestataire (sinon par le demandeur)
  body       String
  createdAt  DateTime     @default(now())

  @@index([rfqId, supplierId])
}

model RfqSupplier {
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Organization @relation(fields: [supplierId], references: [id])
  declined   Boolean      @default(false)

  @@id([rfqId, supplierId])
}

model Quote {
  id          String       @id @default(cuid())
  rfqId       String
  rfq         Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Organization @relation(fields: [supplierId], references: [id])
  amountCents Int          // total HT (somme des lignes quand le devis est détaillé)
  delay       String?
  note        String?
  // Devis détaillé : lignes [{ label, qty, unitCents }], TVA en points de base (2000 = 20 %), validité, conditions, PDF.
  lines       Json         @default("[]")
  vatBp       Int          @default(2000)
  validUntil  DateTime?
  conditions  String?
  fileKey     String?
  fileName    String?
  revision    Int          @default(1)
  status      QuoteStatus  @default(submitted)
  authorId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([rfqId, supplierId])
}

// Prestation d'hospitalité proposée par l'événement (café, cocktail, nuitée…), valorisée.
model EventBenefit {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  catalogId  String  // id de BENEFIT_CATALOG
  label      String
  valueCents Int

  accepted RegistrationBenefit[]
}

// L'inscription passe toujours par un compte (rattachement nominatif des hospitalités).
model Registration {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  kind           RegistrationKind @default(participant)
  profession     String?
  structure      String?
  createdAt      DateTime @default(now())
  declared       Boolean  @default(false)
  declarationRef String?
  // Pointage à l'accueil : code du badge (QR), heure d'arrivée et personne qui a pointé.
  checkinCode    String?   @unique
  checkedInAt    DateTime?
  checkedInById  String?
  // Rappel de la veille, envoi après l'événement (attestation, questionnaire), code de vérification de l'attestation.
  reminderSentAt  DateTime?
  followUpSentAt  DateTime?
  certificateCode String?   @unique

  benefits RegistrationBenefit[]
  survey   SurveyResponse?

  @@unique([eventId, userId])
}

model RegistrationBenefit {
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  benefitId      String
  benefit        EventBenefit @relation(fields: [benefitId], references: [id])
  valueCents     Int          // valeur figée au moment de l'acceptation

  @@id([registrationId, benefitId])
}

// ─── Opportunités (appels ouverts) ─────────────────────────────────────────

model OpenCall {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  specialty      String?
  typeId         String
  budgetMinCents Int?
  budgetMaxCents Int?
  deadline       DateTime?
  description    String?
  status         OpenCallStatus @default(open)
  // Appel rattaché à un événement (formation, symposium…) : la personne retenue y intervient.
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  slots          Int?         // places à pourvoir (facultatif)
  createdById    String?
  createdAt      DateTime     @default(now())

  applications Application[]

  @@index([eventId])
}

model Application {
  id             String              @id @default(cuid())
  openCallId     String
  openCall       OpenCall            @relation(fields: [openCallId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  message        String?
  status         ApplicationStatus   @default(pending)
  projectId      String?             // dossier ouvert si la candidature est retenue
  createdAt      DateTime            @default(now())

  @@unique([openCallId, practitionerId])
}

// ─── Traçabilité ───────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

// ─── Statuts (valeurs en minuscules, telles qu'elles étaient stockées en texte) ──

// Candidature à un appel ouvert ou à un appel à intervenants.
// declined : retenue, mais l'expert a décliné la proposition d'honoraires.
enum ApplicationStatus {
  pending
  retained
  rejected
  declined
}

enum OpenCallStatus {
  open
  closed
}

enum RfqStatus {
  draft
  sent
  awarded
  cancelled
}

enum QuoteStatus {
  submitted
  retained
  rejected
}

// Relecture d'une version de support.
enum ReviewStatus {
  submitted
  approved
  changes
}

enum ExpenseStatus {
  draft
  engagee
  payee
}

enum RegistrationKind {
  participant
  speaker
}

// Photo du book d'un prestataire (salle, réalisation…), conservée en base comme le logo.
model OrganizationPhoto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String
  caption        String?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Forfait du catalogue d'un prestataire : prérempli dans ses devis.
model SupplierOffer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  unitCents      Int
  unit           String       // personne, forfait, jour, nuit
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Avis vérifié : laissé par l'organisation qui a retenu le prestataire, une fois la prestation passée (un avis par demande).
model SupplierReview {
  id         String       @id @default(cuid())
  supplierId String
  supplier   Organization @relation("reviewSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  clientId   String
  client     Organization @relation("reviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  rfqId      String       @unique
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime     @default(now())

  @@index([supplierId])
}

/** Logo d'une organisation (PNG, JPEG ou WebP, 500 Ko au plus), conservé en base pour ne pas dépendre du stockage S3. */
model OrganizationLogo {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String
  updatedAt      DateTime     @updatedAt
}

// Questionnaire de satisfaction d'un participant (une réponse par inscription ; anonyme pour l'organisateur).
model SurveyResponse {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  overall        Int          // note globale, 1 à 5
  content        Int?         // contenu scientifique
  logistics      Int?         // organisation et accueil
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([eventId])
}

// Note d'honoraires établie par un expert pour une convention signée : figée à l'émission (données recopiées).
model FeeNote {
  id              String              @id @default(cuid())
  number          String              // NH-AAAA-NNN, séquentiel par expert et par année
  practitionerId  String
  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  projectExpertId String?             @unique
  projectExpert   ProjectExpert?      @relation(fields: [projectExpertId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountCents     Int                 // HT
  vatBp           Int                 // TVA en points de base (0 en franchise)
  totalCents      Int                 // TTC
  data            Json                // émetteur, destinataire, objet, quantités (figés)
  issuedAt        DateTime            @default(now())

  @@unique([practitionerId, number])
  @@index([organizationId])
}

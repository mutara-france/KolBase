// KolBase — modèle de données initial
// Dérivé du prototype « Kolbase plateforme » (rôles, dossiers, événements, hospitalités).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Comptes ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("fr")
  notifyPrefs  Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  practitioner  PractitionerProfile?
  memberships   Membership[]
  registrations Registration[]
  messages      Message[]
  auditLogs     AuditLog[]
  sessions      Session[]
  invitationsSent     Invitation[] @relation("invitedBy")
  invitationsAccepted Invitation[] @relation("acceptedBy")
}

// Session de connexion : seul le hash du jeton est stocké.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Un praticien a toujours un profil ; il devient KOL quand il se référence (listed = true).
model PractitionerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession    String
  rpps          String?  @unique
  rppsVerified  Boolean  @default(false)
  country       String   @default("FR")
  city          String?
  hospital      String?
  specialty     String?
  subspecialty  String?
  languages     String[]
  interventionTypes String[]
  dayRateCents  Int?
  orcid         String?
  bio           String?
  responseDays  Int?
  listed        Boolean  @default(false) // référencé comme expert (KOL)
  listedAt      DateTime?
  visibility    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  structures    PractitionerStructure[]
  publications  Publication[]
  projectLinks  ProjectExpert[]
  applications  Application[]
  speakerApplications SpeakerApplication[]
}

// Publication scientifique déclarée par le praticien.
model Publication {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title          String
  journal        String?
  year           Int?
  doi            String?
  keywords       String[]
  createdAt      DateTime            @default(now())

  @@index([practitionerId])
}

// Structure d'exercice / de facturation du praticien (SELARL, SCM…).
model PractitionerStructure {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  name           String
  legalForm      String
  siren          String?
  role           String?
  sharePercent   Int?
  isPayee        Boolean             @default(false)
  since          DateTime?
}

enum OrgKind {
  INDUSTRIEL
  SOCIETE_SAVANTE
  ASSOCIATION_PRO
  ORGANISME_FORMATION
  PRESTATAIRE
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  kind         OrgKind
  sector       String?
  headquarters String?
  size         String?
  areas        String[]
  about        String?
  policy       String?
  contactEmail String?
  responseDays Int?
  listed       Boolean  @default(false)
  visibility   Json     @default("{}")
  complianceSettings Json @default("{}")
  // Prestataires référencés : catégories de prestation et zone couverte.
  supplierCategories String[] @default([])
  coverage           String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members       Membership[]
  projects      Project[]
  events        Event[]
  openCalls     OpenCall[]
  // Mandats : une organisation peut mandater un prestataire.
  mandatesGiven    Mandate[] @relation("mandator")
  mandatesReceived Mandate[] @relation("agency")
  invitations      Invitation[]
  rfqs             Rfq[]         @relation("rfqRequester")
  rfqInvites       RfqSupplier[]
  quotes           Quote[]
}

// Invitation d'un membre par lien (jeton à usage unique, stocké haché).
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  email          String?
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("invitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?        @relation("acceptedBy", fields: [acceptedById], references: [id])
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
}

// Rôles côté organisation (cf. ROLE_LABEL du prototype).
enum OrgRole {
  ADMIN
  EDUCATION      // clinical
  EVENEMENTS     // organisateur
  CUMUL          // éducation + événements
  PRESTATAIRE    // externe mandaté
  RELECTURE      // mlr
  CONFORMITE     // compliance
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId, role])
}

model Mandate {
  id         String       @id @default(cuid())
  mandatorId String
  mandator   Organization @relation("mandator", fields: [mandatorId], references: [id])
  agencyId   String
  agency     Organization @relation("agency", fields: [agencyId], references: [id])
  scope      String?
  startsAt   DateTime     @default(now())
  endsAt     DateTime?
}

// ─── Dossiers (collaborations praticien ↔ organisation) ────────────────────

enum ProjectStatus {
  ATT_EXPERTS   // En attente des experts
  ATT_IND       // En attente de l'organisation
  ACCORD        // Accord de principe
  EN_VALID      // En validation conformité
  BLOQUE        // Bloqué par la conformité
  VALIDE        // Validé par la conformité
  ORDRE         // Autorisation de l'Ordre en cours
  REFUS_ORDRE   // Autorisation refusée
  SIGNATURE     // En signature
  SIGNE         // Signé
  TERMINE       // Terminé
  DECLINE       // Décliné
}

model Project {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  title           String
  typeId          String
  therapeuticArea String?
  origin          String?
  description     String?
  status          ProjectStatus @default(ATT_EXPERTS)
  declared        Boolean       @default(false)
  complianceNote  String?
  ordreRef        String?
  createdById     String?
  budgetCents     Int?
  declarationRef  String?   // référence de publication Transparence Santé
  declaredAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  experts   ProjectExpert[]
  documents Document[]
  messages  Message[]
  expenses  Expense[]
  events    Event[]
  materials Material[]
}

// Support (diaporama, article, vidéo…) soumis à relecture médico-réglementaire.
model Material {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  kind      String   // diaporama, article, video, autre
  createdAt DateTime @default(now())

  versions MaterialVersion[]
}

model MaterialVersion {
  id            String    @id @default(cuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  version       Int
  url           String?
  notes         String?
  status        String    @default("submitted") // submitted | approved | changes
  submittedById String
  reviewerId    String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([materialId, version])
}

model ProjectExpert {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  status         ProjectStatus       @default(ATT_EXPERTS)
  feeCents       Int?                // honoraires totaux proposés (€ HT, en centimes)
  days           Float?              // nombre d'unités (journées, interventions…)
  responseNote   String?
  respondedAt    DateTime?
  createdAt      DateTime            @default(now())

  messages Message[]

  @@unique([projectId, practitionerId])
}

model Document {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type       String   // convention, programme, support…
  name       String
  version    Int      @default(1)
  storageKey String?
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Fil de discussion entre l'organisation et un expert donné.
  projectExpertId String?
  projectExpert   ProjectExpert? @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  date        DateTime
  status      String   @default("draft")
}

// ─── Événements, inscriptions, hospitalités ────────────────────────────────

enum EventFormat {
  PRESENTIEL
  DISTANCIEL
  HYBRIDE
}

model Event {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id])
  title            String
  typeId           String
  therapeuticArea  String?
  description      String?
  startsAt         DateTime
  durationMinutes  Int?
  format           EventFormat  @default(PRESENTIEL)
  city             String?
  venue            String?
  capacity         Int?
  registrationOpen Boolean      @default(true)
  publishedAt      DateTime?
  speakerCallOpen  Boolean      @default(false)
  speakerDeadline  DateTime?
  speakerSlots     Int?
  speakerBudgetMinCents Int?
  speakerBudgetMaxCents Int?
  speakerProfile   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  benefits      EventBenefit[]
  registrations Registration[]
  speakerApplications SpeakerApplication[]
  rfqs          Rfq[]
}

// Candidature d'un expert à un appel à intervenants (rattaché à un événement).
model SpeakerApplication {
  id             String              @id @default(cuid())
  eventId        String
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  message        String?
  status         String              @default("pending") // pending | retained | rejected
  projectId      String?
  createdAt      DateTime            @default(now())

  @@unique([eventId, practitionerId])
}

// Demande de devis adressée à des prestataires référencés.
model Rfq {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("rfqRequester", fields: [organizationId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  category       String
  city           String?
  headcount      Int?
  needs          String
  deadline       DateTime?
  status         String       @default("draft") // draft | sent | awarded | cancelled
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())

  suppliers RfqSupplier[]
  quotes    Quote[]
}

model RfqSupplier {
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Organization @relation(fields: [supplierId], references: [id])
  declined   Boolean      @default(false)

  @@id([rfqId, supplierId])
}

model Quote {
  id          String       @id @default(cuid())
  rfqId       String
  rfq         Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Organization @relation(fields: [supplierId], references: [id])
  amountCents Int
  delay       String?
  note        String?
  status      String       @default("submitted") // submitted | retained | rejected
  authorId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([rfqId, supplierId])
}

// Prestation d'hospitalité proposée par l'événement (café, cocktail, nuitée…), valorisée.
model EventBenefit {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  catalogId  String  // id de BENEFIT_CATALOG
  label      String
  valueCents Int

  accepted RegistrationBenefit[]
}

// L'inscription passe toujours par un compte (rattachement nominatif des hospitalités).
model Registration {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  kind           String   @default("participant") // participant | speaker
  profession     String?
  structure      String?
  createdAt      DateTime @default(now())
  declared       Boolean  @default(false)
  declarationRef String?

  benefits RegistrationBenefit[]

  @@unique([eventId, userId])
}

model RegistrationBenefit {
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  benefitId      String
  benefit        EventBenefit @relation(fields: [benefitId], references: [id])
  valueCents     Int          // valeur figée au moment de l'acceptation

  @@id([registrationId, benefitId])
}

// ─── Opportunités (appels ouverts) ─────────────────────────────────────────

model OpenCall {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  specialty      String?
  typeId         String
  budgetMinCents Int?
  budgetMaxCents Int?
  deadline       DateTime?
  description    String?
  status         String       @default("open") // open | closed
  createdById    String?
  createdAt      DateTime     @default(now())

  applications Application[]
}

model Application {
  id             String              @id @default(cuid())
  openCallId     String
  openCall       OpenCall            @relation(fields: [openCallId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  message        String?
  status         String              @default("pending") // pending | retained | rejected
  projectId      String?             // dossier ouvert si la candidature est retenue
  createdAt      DateTime            @default(now())

  @@unique([openCallId, practitionerId])
}

// ─── Traçabilité ───────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
}

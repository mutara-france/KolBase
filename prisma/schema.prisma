// KolBase — modèle de données initial
// Dérivé du prototype « KolBase plateforme » (rôles, dossiers, événements, hospitalités).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Comptes ────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  firstName    String
  lastName     String
  phone        String?
  locale       String    @default("fr")
  notifyPrefs  Json      @default("{}")
  emailVerifiedAt DateTime? // adresse confirmée par le lien reçu par e-mail
  unsubscribeToken String?  @unique // désinscription de la lettre d'information en un clic
  // Double authentification (application d'authentification, RFC 6238) : secret, activation, dernier pas utilisé
  // (un code ne sert qu'une fois), codes de secours (hachés, à usage unique).
  totpSecret    String?
  totpEnabledAt DateTime?
  totpLastStep  Int?
  recoveryCodes String[]  @default([])
  followsSeenAt DateTime?
  // Photo d'un compte sans profil praticien (membre d'organisation) : date de mise à jour, null sans photo.
  // Un praticien a la sienne sur son profil (PractitionerPhoto), avec son réglage de visibilité.
  photoUpdatedAt DateTime?
  // Compte désactivé par l'équipe KolBase (motif obligatoire) : connexion refusée, sessions fermées ; réversible.
  disabledAt   DateTime?
  disabledNote String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  photo         UserPhoto?
  projectLeads  ProjectLead[]
  practitioner  PractitionerProfile?
  memberships   Membership[]
  registrations Registration[]
  waitlist      WaitlistEntry[]
  messages      Message[]
  rfqMessages   RfqMessage[]
  supplierReviews SupplierReview[]
  auditLogs     AuditLog[]
  sessions      Session[]
  invitationsSent     Invitation[] @relation("invitedBy")
  invitationsAccepted Invitation[] @relation("acceptedBy")
  follows             Follow[]
  authTokens          AuthToken[]
  abstracts           Abstract[]
  reports             Report[]
}

enum AuthTokenPurpose {
  RESET_PASSWORD
  VERIFY_EMAIL
  TWO_FACTOR
}

// Jeton à usage unique envoyé par e-mail (réinitialisation du mot de passe, confirmation d'adresse) : seul son hash est stocké.
model AuthToken {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  tokenHash String           @unique
  expiresAt DateTime
  usedAt    DateTime?
  // Page où revenir après le lien (chemin interne vérifié par safeNext) : réinitialisation, confirmation d'adresse.
  next      String?
  createdAt DateTime         @default(now())

  @@index([userId])
}

// Suivi d'un expert ou d'une organisation : alimente le fil « Mes suivis ».
model Follow {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  practitionerId String?
  practitioner   PractitionerProfile? @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime             @default(now())

  @@unique([userId, practitionerId])
  @@unique([userId, organizationId])
  @@index([practitionerId])
  @@index([organizationId])
}

// Session de connexion : seul le hash du jeton est stocké.
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// Un praticien a toujours un profil ; il devient KOL quand il se référence (listed = true).
model PractitionerProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  profession    String
  rpps          String?  @unique
  rppsVerified  Boolean  @default(false) // identité vérifiée par KolBase (RPPS en France, identifiant du pays sinon)
  country       String   @default("FR")  // pays d'exercice principal (code ISO, « XX » : autre pays)
  licenseNumber String?                  // hors France : identifiant professionnel (INAMI, NPI, n° d'Ordre…)
  city          String?
  // Code postal d'exercice (facultatif) : région dans les statistiques.
  postalCode    String?
  hospital      String?
  // Agent public (praticien hospitalier, hospitalo-universitaire, autre agent d'un établissement public) : une
  // collaboration rémunérée suppose l'autorisation de cumul de l'employeur, transmise avec la convention (R.1453-14 CSP).
  publicAgent   Boolean  @default(false)
  specialty     String?
  subspecialty  String?
  languages     String[]
  interventionTypes String[]
  dayRateCents  Int?
  orcid         String?
  bio           String?
  responseDays  Int?
  listed        Boolean  @default(false) // référencé comme expert (KOL)
  listedAt      DateTime?
  visibility    Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  structures    PractitionerStructure[]
  declaredInterests DeclaredInterest[]
  publications  Publication[]
  projectLinks  ProjectExpert[]
  applications  Application[]
  followers     Follow[]
  orcidSyncedAt DateTime?
  orcidVerified Boolean   @default(false) // iD obtenu par connexion au compte ORCID
  rppsCheckedAt DateTime? // contrôle du RPPS par un administrateur KolBase (validé ou refusé)
  rppsCheckNote String?   // motif d'un refus
  // Coordonnées de facturation en nom propre (conventions et notes d'honoraires) : adresse, SIRET, TVA, IBAN. Une
  // convention facturée au nom d'une structure (cabinet, association…) reprend les coordonnées de cette structure.
  billingAddress String?
  // Ancienne « société d'exercice », reprise dans les structures : plus lue. Exclue du client Prisma (@ignore) mais
  // gardée en base le temps d'un déploiement, pour que l'ancienne version encore en service ne lise pas une colonne
  // disparue ; à supprimer par une migration ultérieure (DROP COLUMN), une fois cette version en production.
  billingEntity  String? @ignore
  siret          String?
  vatRegime      String   @default("franchise") // franchise (art. 293 B du CGI) ou assujetti
  vatNumber      String?
  iban           String?
  feeNotes       FeeNote[]
  // Photo (portrait recadré et réencodé par KolBase, métadonnées retirées), servie par /experts/[id]/photo selon le
  // réglage de visibilité « photo » : date de mise à jour, null sans photo.
  photoUpdatedAt DateTime?
  // Accord pour l'usage de la photo dans la communication de ses interventions (programme, affiches, réseaux
  // sociaux, e-mailing) par les organisations avec qui il collabore et par KolBase : date de l'accord, null sinon.
  photoConsentAt DateTime?
  photo          PractitionerPhoto?
  proposals      ExpertProposal[]
}

/** Photo d'un praticien, conservée en base comme les logos : grand format (JPEG 800 px) et vignette (WebP 192 px). */
/**
 * Photo d'un compte sans profil praticien : grand format (JPEG 800 px) et vignette (WebP 192 px), visibles de la
 * personne, des membres de ses organisations et de l'équipe KolBase.
 */
model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  thumb     Bytes
  updatedAt DateTime @updatedAt
}

model PractitionerPhoto {
  practitionerId String              @id
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  data           Bytes
  thumb          Bytes
  updatedAt      DateTime            @updatedAt
}

// Projet proposé par un expert à une ou plusieurs organisations (cinq au plus) : chacune en reçoit sa copie, un dossier
// à elle (« Proposition de l'expert »), sans savoir qui d'autre l'a reçu. Les copies gardent le texte envoyé.
model ExpertProposal {
  id              String              @id @default(cuid())
  practitionerId  String
  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title           String
  typeId          String
  therapeuticArea String?
  description     String              // objectif et contenu
  audience        String?             // public visé et format
  schedule        String?             // calendrier envisagé
  // Besoins logistiques (lieu, matériel, restauration…) : l'organisation qui accepte les organise et les prend en charge.
  logistics       String?
  feeCents        Int?                // honoraires souhaités (total HT)
  units           Float?
  // Sujet (aiguillage vers le bon canal de l'organisation) ; idée de produit : conditions de soumission acceptées,
  // accord de confidentialité demandé avant de détailler.
  topic           String?
  ipAckAt         DateTime?
  ndaRequested    Boolean             @default(false)
  createdAt       DateTime            @default(now())

  projects Project[]

  @@index([practitionerId, createdAt])
}

// Publication scientifique déclarée par le praticien.
model Publication {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  title          String
  journal        String?
  year           Int?
  doi            String?
  keywords       String[]
  source         String?             // orcid si importée
  createdAt      DateTime            @default(now())

  @@index([practitionerId])
}

// Structure d'exercice / de facturation du praticien (SELARL, SCM, association…).
model PractitionerStructure {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  name           String
  legalForm      String
  siren          String?
  role           String?
  sharePercent   Int?
  // Structure proposée par défaut pour facturer une nouvelle convention (une au plus) ; sinon, le nom propre.
  isPayee        Boolean             @default(false)
  since          DateTime?
  // Coordonnées de facturation de la structure (conventions et notes d'honoraires établies à son nom).
  billingAddress String?
  siret          String?
  vatRegime      String              @default("franchise")
  vatNumber      String?
  iban           String?
  billedLinks    ProjectExpert[]

  @@index([practitionerId])
}

// Lien d'intérêts noué hors de KolBase, déclaré par le praticien (complète sa déclaration de liens d'intérêts).
model DeclaredInterest {
  id             String              @id @default(cuid())
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  organization   String
  nature         String
  startYear      Int
  endYear        Int?
  createdAt      DateTime            @default(now())

  @@index([practitionerId])
}

// Validation des organisations par KolBase (SIREN contrôlé, puis validation par un administrateur).
// Suspendue : validée puis mise en pause par KolBase (motif) ; pages publiques, événements et appels masqués,
// rien n'est supprimé, la réactivation rend tout.
enum OrgVerification {
  PENDING
  VERIFIED
  REJECTED
  SUSPENDED
}

enum OrgKind {
  INDUSTRIEL
  SOCIETE_SAVANTE
  ASSOCIATION_PRO
  ORGANISME_FORMATION
  PRESTATAIRE
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  kind         OrgKind
  require2fa   Boolean  @default(false) // double authentification exigée de tous les membres
  // Événements validés par la conformité avant publication (par défaut pour un industriel, réglable).
  eventReview  Boolean  @default(false)
  sector       String?
  headquarters String?
  size         String?
  areas        String[]
  about        String?
  policy       String?
  contactEmail String?
  responseDays Int?
  listed       Boolean  @default(false)
  visibility   Json     @default("{}")
  complianceSettings Json @default("{}")
  // Grille de rémunération définie par la conformité (taux horaires par niveau d'expert ou d'activité).
  feeLevels          FeeLevel[]
  // Prestataires référencés : catégories de prestation et zone couverte.
  supplierCategories String[] @default([])
  coverage           String?
  // Book prestataire : capacités ({ seats, cocktail, banquet, rooms }), équipements, accessibilité, prix indicatif.
  capacities         Json     @default("{}")
  equipment          String[] @default([])
  accessible         Boolean  @default(false)
  priceHint          String?
  // Identité légale et validation par KolBase.
  siren              String?
  legalName          String?          // dénomination officielle (API Recherche d'entreprises)
  sirenActive        Boolean?         // entreprise active selon l'API (null : contrôle impossible)
  sirenCheckedAt     DateTime?
  // Association ou société savante sans SIREN : numéro RNA (W suivi de 9 chiffres), vérifié par KolBase.
  rna                String?
  verification       OrgVerification  @default(PENDING)
  // Dernière demande de validation transmise à KolBase (création, SIREN ou RNA, nouveau nom).
  verificationRequestedAt DateTime?
  verifiedAt         DateTime?
  verifiedById       String?
  verificationNote   String?
  // Logo (image stockée à part, servie par /logos/[id]) : date de mise à jour, null si aucun logo.
  logoUpdatedAt      DateTime?
  // Bannière de la vitrine (prestataire) : date de mise à jour, null sans bannière.
  bannerUpdatedAt    DateTime?
  // Contrat de sous-traitance (RGPD, art. 28) accepté au nom de l'organisation : version, date, administrateur.
  dpaVersion         String?
  dpaAcceptedAt      DateTime?
  dpaAcceptedById    String?
  // Organisme de formation (ou société savante qui forme) : numéro de déclaration d'activité, certificat Qualiopi
  // (numéro et certificateur), référent handicap. Repris sur les fiches de formation et les attestations.
  nda                String?
  qualiopi           String?
  handicapContact    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  logo          OrganizationLogo?
  banner        OrganizationBanner?
  feeNotes      FeeNote[]
  subscription  Subscription?
  serviceOrders ServiceOrder[]
  photos        OrganizationPhoto[]
  offers        SupplierOffer[]
  reviewsReceived SupplierReview[] @relation("reviewSupplier")
  reviewsGiven    SupplierReview[] @relation("reviewClient")
  members       Membership[]
  projects      Project[]
  events        Event[]       @relation("orgEvents")
  openCalls     OpenCall[]
  // Mandats : une organisation peut mandater un prestataire.
  mandatesGiven    Mandate[] @relation("mandator")
  mandatesReceived Mandate[] @relation("agency")
  invitations      Invitation[]
  rfqs             Rfq[]         @relation("rfqRequester")
  rfqInvites       RfqSupplier[]
  quotes           Quote[]
  rfqMessages      RfqMessage[]
  followers        Follow[]
  agencyEvents     Event[]       @relation("agencyEvents")
  // Partenariats d'événements (congrès d'une société savante, d'une association) proposés à l'organisation.
  eventPartnerships EventPartner[]
  // Groupe (plusieurs entités dans le monde) et périmètre de l'entité : pays couverts (vide : siège, tous pays),
  // marques ; canaux de contact par sujet.
  groupId          String?
  group            OrgGroup?        @relation(fields: [groupId], references: [id], onDelete: SetNull)
  coveredCountries String[]         @default([])
  brands           String[]         @default([])
  channels         ContactChannel[]
}

/** Groupe d'organisations (industriel présent dans plusieurs pays) : ses entités sont rattachées par l'équipe KolBase. */
model OrgGroup {
  id        String         @id @default(cuid())
  name      String
  about     String?
  createdAt DateTime       @default(now())
  entities  Organization[]
}

/**
 * Canal d'une organisation pour un sujet (formation, recherche clinique, innovation…) : membre responsable, suppléant,
 * délai de réponse, conditions de soumission d'une idée. Les propositions des experts y sont aiguillées.
 */
model ContactChannel {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  topic          String
  ownerId        String
  backupId       String?
  responseDays   Int          @default(10)
  ipPolicy       String?
  createdAt      DateTime     @default(now())
  projects       Project[]

  @@unique([organizationId, topic])
}

// Invitation d'un membre par lien (jeton à usage unique, stocké haché).
model Invitation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  email          String?
  tokenHash      String       @unique
  invitedById    String
  invitedBy      User         @relation("invitedBy", fields: [invitedById], references: [id])
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  acceptedBy     User?        @relation("acceptedBy", fields: [acceptedById], references: [id])
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Rôles côté organisation (cf. ROLE_LABEL du prototype).
enum OrgRole {
  ADMIN          // équipe, fiche et réglages ; accès à tout
  PROJETS        // experts, dossiers, événements, prestataires (ex-Éducation, Événements)
  CONFORMITE     // validation, relecture des supports, déclarations (ex-Conformité, Relecture)
  PRESTATAIRE    // client : agence mandatée (événements confiés) ; prestataire : membre de l'équipe
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           OrgRole
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId, role])
  @@index([organizationId])
}

model Mandate {
  id         String       @id @default(cuid())
  mandatorId String
  mandator   Organization @relation("mandator", fields: [mandatorId], references: [id])
  agencyId   String
  agency     Organization @relation("agency", fields: [agencyId], references: [id])
  scope      String?
  // Droit de retenir un devis au nom de l'organisation (sinon l'agence propose, l'organisateur retient).
  canAward   Boolean      @default(false)
  startsAt   DateTime     @default(now())
  endsAt     DateTime?

  @@index([mandatorId])
  @@index([agencyId])
}

// ─── Dossiers (collaborations praticien ↔ organisation) ────────────────────

enum ProjectStatus {
  ATT_EXPERTS   // En attente des experts
  ATT_IND       // En attente de l'organisation
  ACCORD        // Accord de principe
  EN_VALID      // En validation conformité
  BLOQUE        // Bloqué par la conformité
  VALIDE        // Validé par la conformité
  ORDRE         // Autorisation de l'Ordre en cours
  REFUS_ORDRE   // Autorisation refusée
  SIGNATURE     // En signature
  SIGNE         // Signé
  TERMINE       // Terminé
  DECLINE       // Décliné
}

/// Responsable d'un dossier (un ou plusieurs par dossier) : membre Administrateur ou Projets de l'organisation.
/// Le créateur l'est d'office ; un dossier sans responsable (projet proposé par un expert) revient à qui le fait avancer.
model ProjectLead {
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

model Project {
  id              String        @id @default(cuid())
  organizationId  String
  organization    Organization  @relation(fields: [organizationId], references: [id])
  title           String
  typeId          String
  therapeuticArea String?
  origin          String?
  description     String?
  status          ProjectStatus @default(ATT_EXPERTS)
  declared        Boolean       @default(false)
  complianceNote  String?
  ordreRef        String?
  // Seconde validation (réglage secondValidationAbove) : première validation posée, la seconde, par un autre membre
  // Conformité, fait passer le dossier « Validé ». Effacés quand le dossier repasse en accord de principe.
  firstValidatedById String?
  firstValidatedAt   DateTime?
  // Démarche EPS (dispositif anti-cadeaux) : date de la déclaration simple et sa référence, date de la demande
  // d'autorisation à l'Ordre. Preuve du respect des délais (8 jours ouvrables, 2 mois avant l'exécution).
  epsDeclaredAt    DateTime?
  epsRef           String?
  ordreRequestedAt DateTime?
  createdById     String?
  budgetCents     Int?
  declarationRef  String?   // référence de publication Transparence Santé
  declaredAt      DateTime?
  // Signature attestée sans convention déposée (stockage de documents non configuré) : qui et quand.
  signatureAttestedAt   DateTime?
  signatureAttestedById String?
  // Motif de l'abandon du dossier : affiché à l'expert sur sa sollicitation.
  abandonNote     String?
  // Délais internes : date d'intervention prévue (à défaut, celle de l'événement du dossier), dernière soumission à la
  // conformité, et dernière relance de la conformité pour un examen en retard.
  plannedAt        DateTime?
  submittedAt      DateTime?
  reviewReminderAt DateTime?
  // Contrat-cadre : plusieurs prestations d'un même type sur une période (douze mois au plus), dans la limite des
  // unités prévues à la convention ; chaque mission réalisée est consignée.
  framework       Boolean       @default(false)
  periodEnd       DateTime?
  // Copie d'un projet proposé par un expert (envoyé à plusieurs organisations, chacune a la sienne).
  proposalId      String?
  proposal        ExpertProposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  // Canal de l'organisation qui reçoit la proposition (sujet, responsable) et réponse attendue (délai du canal).
  channelId       String?
  channel         ContactChannel? @relation(fields: [channelId], references: [id], onDelete: SetNull)
  responseDue     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Responsables côté organisation (Administrateur ou Projets) : vue « Mes dossiers », e-mails du dossier.
  leads     ProjectLead[]
  experts   ProjectExpert[]
  documents Document[]
  messages  Message[]
  expenses  Expense[]
  events    Event[]
  materials Material[]

  @@index([organizationId])
  @@index([proposalId])
}

/**
 * Note de frais d'un expert (frais réels sur justificatif : transport, hôtel, repas) : déposée par l'expert,
 * acceptée ou refusée par l'organisation, puis remboursée. Les frais remboursés sont des avantages déclarés avec
 * la convention (Transparence Santé ; betransparent.be pour un expert exerçant en Belgique).
 */
model ExpertExpense {
  id              String        @id @default(cuid())
  projectExpertId String
  projectExpert   ProjectExpert @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  category        String        // transport, hebergement, repas, autre
  label           String
  date            DateTime
  amountCents     Int           // TTC
  documentId      String?       // justificatif (Document de nature JUSTIFICATIF)
  status          String        @default("submitted") // submitted, approved, rejected, paid
  decidedById     String?
  decidedAt       DateTime?
  decisionNote    String?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())

  @@index([projectExpertId])
}

/** Billets et hébergement d'un expert réservés par l'organisation (visible de l'expert, envoyé par e-mail). */
model ExpertTravel {
  projectExpertId String        @id
  projectExpert   ProjectExpert @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  hotel           String?
  hotelRef        String?
  checkIn         DateTime?
  checkOut        DateTime?
  roomType        String?
  outbound        String?
  returnTrip      String?
  ticketRef       String?
  notes           String?
  sentAt          DateTime?
  updatedAt       DateTime      @updatedAt
}

/** Mission réalisée par un expert dans le cadre d'un contrat-cadre (date, objet, unités consommées). */
model FrameworkMission {
  id              String        @id @default(cuid())
  projectExpertId String
  projectExpert   ProjectExpert @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  date            DateTime
  label           String
  units           Float
  createdById     String?
  createdAt       DateTime      @default(now())

  @@index([projectExpertId])
}

// Support (diaporama, article, vidéo…) soumis à relecture médico-réglementaire.
model Material {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  kind      String   // diaporama, article, video, autre
  createdAt DateTime @default(now())

  versions MaterialVersion[]

  @@index([projectId])
}

model MaterialVersion {
  id            String    @id @default(cuid())
  materialId    String
  material      Material  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  version       Int
  url           String?
  notes         String?
  status        ReviewStatus @default(submitted)
  submittedById String
  reviewerId    String?
  reviewComment String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@unique([materialId, version])
}

/// Niveau de la grille de rémunération d'une organisation : un libellé (ex. « Expert national ») et un taux horaire HT.
model FeeLevel {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  hourlyCents    Int
  createdAt      DateTime        @default(now())
  experts        ProjectExpert[]

  @@index([organizationId])
}

model ProjectExpert {
  id             String              @id @default(cuid())
  projectId      String
  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  status         ProjectStatus       @default(ATT_EXPERTS)
  feeCents       Int?                // honoraires totaux proposés (€ HT, en centimes)
  days           Float?              // nombre d'unités (journées, interventions…)
  responseNote   String?
  respondedAt    DateTime?
  // Relance de la sollicitation restée sans réponse (une seule, à l'échéance du délai interne de l'organisation),
  // puis date à laquelle l'organisation a été prévenue du silence (double du délai : « sans réponse »).
  reminderSentAt DateTime?
  unansweredAt   DateTime?
  // Contre-proposition de l'expert (€ HT, en centimes) : la sollicitation reste ouverte, l'organisation répond.
  desiredFeeCents Int?
  // Honoraires précédents, quand l'organisation en a proposé d'autres ou a accepté ceux de l'expert.
  previousFeeCents Int?
  // Volume horaire déclaré (heures, facultatif) et niveau de la grille de rémunération appliqué : le taux horaire réel
  // (honoraires ÷ heures) sert au contrôle du seuil horaire. Taux et libellé du niveau sont figés à la proposition.
  prepHours         Float?
  interventionHours Float?
  travelHours       Float?
  feeLevelId        String?
  feeLevel          FeeLevel? @relation(fields: [feeLevelId], references: [id], onDelete: SetNull)
  feeLevelLabel     String?
  hourlyCents       Int?
  // Paiement des honoraires, indiqué par l'organisation (visible de l'expert dans « Mes revenus »).
  paidAt         DateTime?
  paidCents      Int?
  // Au nom de qui la convention est facturée, choisi par l'expert pendant le recrutement : une de ses structures
  // (billingStructureId) ou son nom propre (billingSelf). Sans choix, sa structure par défaut ; figé à la soumission
  // du dossier à la conformité (lib/expert-billing).
  billingStructureId String?
  billingStructure   PractitionerStructure? @relation(fields: [billingStructureId], references: [id], onDelete: SetNull)
  billingSelf        Boolean                @default(false)
  createdAt      DateTime            @default(now())

  messages  Message[]
  documents Document[]
  signature ConventionSignature?
  feeNote   FeeNote?
  expenses  ExpertExpense[]
  travel    ExpertTravel?
  missions  FrameworkMission[]

  @@unique([projectId, practitionerId])
  @@index([practitionerId])
}

// Statut d'une demande de signature électronique (valeurs du prestataire, Yousign).
enum SignatureStatus {
  draft
  ongoing
  done
  declined
  expired
  canceled
}

// Signature électronique (Yousign) de la convention d'un expert. Une seule demande suivie par expert :
// un nouvel envoi (après refus, expiration ou annulation) remplace la précédente ; l'historique est dans AuditLog.
model ConventionSignature {
  id              String          @id @default(cuid())
  projectExpertId String          @unique
  projectExpert   ProjectExpert   @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  requestId       String          @unique // identifiant de la demande chez le prestataire
  documentId      String?         // identifiant du document à signer chez le prestataire
  status          SignatureStatus @default(draft)
  sentById        String?         // signataire côté organisation (auteur de l'envoi)
  sentAt          DateTime?
  completedAt     DateTime?
  note            String?         // motif d'un refus, échec de l'envoi
  // Rappels aux signataires en retard (J+3, J+7 après l'envoi) : nombre envoyés et date du dernier.
  reminders       Int             @default(0)
  reminderSentAt  DateTime?
  updatedAt       DateTime        @updatedAt
}

// Pièce d'un dossier, stockée dans le stockage objet (S3 compatible) : convention signée d'un expert ou autre pièce.
enum DocumentKind {
  CONVENTION_SIGNEE
  PIECE
  // Autorisation de cumul d'activités (ou accusé de la déclaration) d'un expert agent public.
  AUTORISATION_CUMUL
  // Justificatif d'une note de frais d'expert (billet, facture d'hôtel, ticket de repas).
  JUSTIFICATIF
}

model Document {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Expert concerné (convention signée, pièce qui le concerne) : il voit et télécharge le document.
  projectExpertId String?
  projectExpert   ProjectExpert? @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  kind            DocumentKind   @default(PIECE)
  name            String         // nom du fichier déposé
  contentType     String
  size            Int
  storageKey      String         @unique
  uploadedById    String?
  createdAt       DateTime       @default(now())

  @@index([projectId])
  @@index([projectExpertId])
}

model Message {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  // Fil de discussion entre l'organisation et un expert donné.
  projectExpertId String?
  projectExpert   ProjectExpert? @relation(fields: [projectExpertId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([projectExpertId])
}

model Expense {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  label       String
  amountCents Int
  date        DateTime
  status      ExpenseStatus @default(draft)

  @@index([projectId])
}

// ─── Événements, inscriptions, hospitalités ────────────────────────────────

enum EventFormat {
  PRESENTIEL
  DISTANCIEL
  HYBRIDE
}

model Event {
  id               String       @id @default(cuid())
  organizationId   String
  organization     Organization @relation("orgEvents", fields: [organizationId], references: [id])
  projectId        String?
  project          Project?     @relation(fields: [projectId], references: [id])
  title            String
  typeId           String
  therapeuticArea  String?
  description      String?
  startsAt         DateTime
  durationMinutes  Int?
  format           EventFormat  @default(PRESENTIEL)
  city             String?
  // Code postal du lieu (facultatif) : région dans les statistiques.
  postalCode       String?
  venue            String?
  capacity         Int?
  registrationOpen Boolean      @default(true)
  publishedAt      DateTime?
  // Réunion interne (board, comité…) : ni publication dans l'agenda, ni inscriptions en ligne.
  internal         Boolean      @default(false)
  // Validation par la conformité avant publication (organisations qui l'exigent) : lieu, date, programme, hospitalités.
  // null : non soumis ; « submitted » : en attente ; « approved » : validé ; « changes » : modifications demandées.
  reviewStatus     String?
  reviewSubmittedAt DateTime?
  reviewSubmittedById String?
  reviewedAt       DateTime?
  reviewedById     String?
  reviewNote       String?
  /// Changements (date, lieu, format, hospitalités) qui ont renvoyé l'événement validé à la conformité.
  reviewChanges    String[] @default([])
  program          String?      // programme scientifique (déroulé horaire), affiché sur la page publique
  // Lien de connexion (visioconférence, https) des événements en ligne ou hybrides : communiqué aux seuls inscrits.
  onlineUrl        String?
  // Belgique : visa Mdeon (manifestation de plusieurs jours ou avec nuitée, hospitalité offerte à des praticiens
  // exerçant en Belgique). Sans numéro, ces praticiens s'inscrivent sans hospitalité.
  mdeonVisa        String?
  mdeonVisaAt      DateTime?
  // Adresse postale du lieu (rue et numéro), en plus du nom du lieu, du code postal et de la ville.
  address          String?
  // Sur invitation : hors de l'agenda public, page et inscription réservées aux invités (comité, atelier fermé…).
  inviteOnly       Boolean      @default(false)
  // Congrès d'un tiers (ADF, société savante) auquel l'organisation invite des praticiens : son organisateur et sa page.
  hostedBy         String?
  hostedUrl        String?
  // Agence prestataire mandatée : ses membres (rôle Prestataire) ne voient que les événements confiés.
  agencyId         String?
  agency           Organization? @relation("agencyEvents", fields: [agencyId], references: [id])
  // Événement annulé (avec des inscrits) : lisible à son adresse avec la mention, hors de l'agenda, sans inscription.
  cancelledAt      DateTime?
  cancelReason     String?
  // Appel à communications (congrès) : ouvert jusqu'à cette date, thèmes proposés.
  abstractsDeadline DateTime?
  abstractTopics    String[]     @default([])
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  benefits      EventBenefit[]
  registrations Registration[]
  waitlist      WaitlistEntry[]
  messages      EventMessage[]
  invites       EventInvite[]
  budgetLines   EventBudgetLine[]
  training      TrainingSheet?
  sessions      EventSession[]
  rooms         EventRoom[]
  programItems  ProgramItem[]
  partners      EventPartner[]
  abstracts     Abstract[]
  surveys       SurveyResponse[]
  serviceOrders ServiceOrder[]
  rfqs          Rfq[]
  calls         OpenCall[]

  @@index([organizationId, startsAt])
  @@index([startsAt])
  @@index([agencyId])
  @@index([projectId])
}

// Demande de devis adressée à des prestataires référencés.
model Rfq {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation("rfqRequester", fields: [organizationId], references: [id])
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id])
  category       String
  city           String?
  headcount      Int?
  needs          String
  // Questions propres à la catégorie (format, configuration, nuits, trajets…), voir supplier-profiles.
  details        Json         @default("{}")
  // Dates de la prestation (à défaut, celles de l'événement) : une demande sans événement en a besoin pour être chiffrée.
  serviceStart   DateTime?
  serviceEnd     DateTime?
  // Nombre définitif confirmé au prestataire retenu (traiteur, hôtel, transport, lieu), avec la date et l'auteur.
  finalHeadcount   Int?
  finalHeadcountAt DateTime?
  finalHeadcountById String?
  deadline       DateTime?
  status         RfqStatus    @default(draft)
  sentAt         DateTime?
  createdById    String?
  // Devis proposé par l'agence mandatée (sans droit de retenir) : l'organisateur décide.
  proposedQuoteId String?
  proposedById    String?
  proposedAt      DateTime?
  // Annulation : par qui et quand (l'organisation cliente ou l'auteur de la demande).
  cancelledAt     DateTime?
  cancelledById   String?
  createdAt      DateTime     @default(now())

  suppliers RfqSupplier[]
  quotes    Quote[]
  messages  RfqMessage[]
  review    SupplierReview?

  @@index([organizationId])
  @@index([eventId])
}

// Questions et échanges sur une demande de devis : un fil privé entre le demandeur et chaque prestataire consulté.
model RfqMessage {
  id         String       @id @default(cuid())
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Organization @relation(fields: [supplierId], references: [id])
  authorId   String
  author     User         @relation(fields: [authorId], references: [id])
  fromSupplier Boolean    @default(false) // écrit par le prestataire (sinon par le demandeur)
  body       String
  createdAt  DateTime     @default(now())

  @@index([rfqId, supplierId])
}

model RfqSupplier {
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Organization @relation(fields: [supplierId], references: [id])
  declined   Boolean      @default(false)
  // Déclin : motif facultatif (montré au client) et date.
  declineNote String?
  declinedAt  DateTime?
  // Dernière relance par le demandeur (au plus une fois par 48 heures).
  remindedAt  DateTime?

  @@id([rfqId, supplierId])
  @@index([supplierId])
}

model Quote {
  id          String       @id @default(cuid())
  rfqId       String
  rfq         Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId  String
  supplier    Organization @relation(fields: [supplierId], references: [id])
  amountCents Int          // total HT (somme des lignes quand le devis est détaillé)
  delay       String?
  note        String?
  // Devis détaillé : lignes [{ label, qty, unitCents, vatBp }] (taux par ligne, en points de base : 2000 = 20 %), validité,
  // conditions, PDF. vatBp : taux unique, ou principal quand les lignes en ont plusieurs (lignes sans taux, montant global).
  lines       Json         @default("[]")
  vatBp       Int          @default(2000)
  // Total TTC : somme des lignes à leur taux (null : montant HT au taux du devis).
  ttcCents    Int?
  validUntil  DateTime?
  conditions  String?
  // Conditions structurées : acompte (% du TTC) et barème d'annulation (sans frais jusqu'à J-x, pourcentage dû
  // entre J-x et J-y, totalité due à moins de J-y).
  depositPct     Int?
  cancelFreeDays Int?
  cancelMidPct   Int?
  cancelFullDays Int?
  fileKey     String?
  fileName    String?
  revision    Int          @default(1)
  status      QuoteStatus  @default(submitted)
  authorId    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

// Prestation d'hospitalité proposée par l'événement (café, cocktail, nuitée…), valorisée.
model EventBenefit {
  id         String  @id @default(cuid())
  eventId    String
  event      Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  catalogId  String  // id de BENEFIT_CATALOG
  label      String
  valueCents Int

  accepted RegistrationBenefit[]

  @@index([eventId])
}

// L'inscription passe toujours par un compte (rattachement nominatif des hospitalités).
model Registration {
  id             String   @id @default(cuid())
  eventId        String
  event          Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  kind           RegistrationKind @default(participant)
  profession     String?
  structure      String?
  createdAt      DateTime @default(now())
  declared       Boolean  @default(false)
  declarationRef String?
  // Pointage à l'accueil : code du badge (QR), heure d'arrivée et personne qui a pointé.
  checkinCode    String?   @unique
  checkedInAt    DateTime?
  checkedInById  String?
  // Rappel de la veille, envoi après l'événement (attestation, questionnaire), code de vérification de l'attestation.
  reminderSentAt  DateTime?
  followUpSentAt  DateTime?
  certificateCode String?   @unique
  // Inscription arrivée par un lien suivi d'un service KolBase (e-mailing, post, à la une).
  sourceOrderId   String?
  sourceOrder     ServiceOrder? @relation(fields: [sourceOrderId], references: [id], onDelete: SetNull)
  // Inscription annulée par l'annulation de l'événement (l'annulation par la personne inscrite la supprime).
  cancelledAt     DateTime?
  // Besoins déclarés à l'inscription (facultatifs, avec l'accord explicite de la personne : données de santé ou
  // révélant des convictions) : régime alimentaire, allergies, accessibilité ou adaptation. Transmis à l'organisateur
  // et à ses prestataires pour l'événement, effacés 30 jours après sa fin.
  diet            String?
  allergies       String?
  needs           String?
  needsConsentAt  DateTime?
  // Évaluation des acquis (formation) par l'organisateur : acquis, partiel, non_acquis.
  assessment      String?
  assessedAt      DateTime?

  benefits    RegistrationBenefit[]
  survey      SurveyResponse?
  travel      RegistrationTravel?
  attendances Attendance[]

  @@unique([eventId, userId])
  @@index([userId])
  @@index([sourceOrderId])
}

/** Liste d'attente d'un événement complet : prévenue dans l'ordre quand une place se libère (place non réservée). */
model WaitlistEntry {
  id         String    @id @default(cuid())
  eventId    String
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  notifiedAt DateTime?

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
}

/** Invitation nominative à un événement sur invitation : lien à usage personnel (jeton stocké haché), relance, réponse. */
model EventInvite {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  email       String
  firstName   String?
  lastName    String?
  // Compte rattaché (inscription faite depuis l'invitation, ou adresse d'un compte existant).
  userId      String?
  tokenHash   String    @unique
  invitedAt   DateTime  @default(now())
  // Envoi de l'invitation (à l'ajout, ou à la publication pour un événement encore en brouillon).
  sentAt      DateTime?
  remindedAt  DateTime?
  declinedAt  DateTime?
  createdById String?

  @@unique([eventId, email])
  @@index([eventId])
}

/**
 * Voyage et hébergement d'un participant (nuitée, transport acceptés) : demandes du participant, puis réservations
 * de l'organisateur ou de son agence ; carnet de voyage envoyé au participant, liste des chambres pour l'hôtel.
 */
model RegistrationTravel {
  registrationId String       @id
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  departureCity  String?
  checkIn        DateTime?
  checkOut       DateTime?
  roomType       String?      // single, double
  hotel          String?
  hotelRef       String?
  outbound       String?
  returnTrip     String?
  ticketRef      String?
  notes          String?
  sentAt         DateTime?
  updatedAt      DateTime     @updatedAt
}

/** Budget d'un événement par poste (catégorie de prestataire ou autre) : prévu, face aux devis retenus. */
model EventBudgetLine {
  id           String   @id @default(cuid())
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  category     String
  label        String
  plannedCents Int
  createdAt    DateTime @default(now())

  @@index([eventId])
}

/** Message de l'organisateur aux inscrits d'un événement (envoyé par e-mail, gardé en historique). */
model EventMessage {
  id         String   @id @default(cuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  authorId   String
  subject    String
  body       String
  recipients Int
  createdAt  DateTime @default(now())

  @@index([eventId, createdAt])
}

model RegistrationBenefit {
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  benefitId      String
  benefit        EventBenefit @relation(fields: [benefitId], references: [id])
  valueCents     Int          // valeur figée au moment de l'acceptation

  @@id([registrationId, benefitId])
  @@index([benefitId])
}

// ─── Opportunités (appels ouverts) ─────────────────────────────────────────

model OpenCall {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  title          String
  specialty      String?
  typeId         String
  budgetMinCents Int?
  budgetMaxCents Int?
  deadline       DateTime?
  description    String?
  status         OpenCallStatus @default(open)
  // Appel rattaché à un événement (formation, symposium…) : la personne retenue y intervient.
  eventId        String?
  event          Event?       @relation(fields: [eventId], references: [id], onDelete: SetNull)
  slots          Int?         // places à pourvoir (facultatif)
  createdById    String?
  createdAt      DateTime     @default(now())

  applications Application[]

  @@index([eventId])
  @@index([organizationId])
}

model Application {
  id             String              @id @default(cuid())
  openCallId     String
  openCall       OpenCall            @relation(fields: [openCallId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   PractitionerProfile @relation(fields: [practitionerId], references: [id])
  message        String?
  status         ApplicationStatus   @default(pending)
  projectId      String?             // dossier ouvert si la candidature est retenue
  createdAt      DateTime            @default(now())

  @@unique([openCallId, practitionerId])
  @@index([practitionerId])
}

// ─── Traçabilité ───────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  data       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([actorId])
}

// ─── Statuts (valeurs en minuscules, telles qu'elles étaient stockées en texte) ──

// Candidature à un appel ouvert ou à un appel à intervenants.
// declined : retenue, mais l'expert a décliné la proposition d'honoraires.
enum ApplicationStatus {
  pending
  retained
  rejected
  declined
}

enum OpenCallStatus {
  open
  closed
}

enum RfqStatus {
  draft
  sent
  awarded
  cancelled
}

enum QuoteStatus {
  submitted
  retained
  rejected
}

// Relecture d'une version de support.
enum ReviewStatus {
  submitted
  approved
  changes
}

enum ExpenseStatus {
  draft
  engagee
  payee
}

enum RegistrationKind {
  participant
  speaker
}

// Photo du book d'un prestataire (salle, réalisation…), conservée en base comme le logo.
model OrganizationPhoto {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String
  caption        String?
  position       Int          @default(0)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Forfait du catalogue d'un prestataire : prérempli dans ses devis.
model SupplierOffer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String
  unitCents      Int
  unit           String       // personne, forfait, jour, nuit
  createdAt      DateTime     @default(now())

  @@index([organizationId])
}

// Avis vérifié : laissé par l'organisation qui a retenu le prestataire, une fois la prestation passée (un avis par demande).
model SupplierReview {
  id         String       @id @default(cuid())
  supplierId String
  supplier   Organization @relation("reviewSupplier", fields: [supplierId], references: [id], onDelete: Cascade)
  clientId   String
  client     Organization @relation("reviewClient", fields: [clientId], references: [id], onDelete: Cascade)
  rfqId      String       @unique
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  authorId   String
  author     User         @relation(fields: [authorId], references: [id])
  rating     Int
  comment    String?
  // Avis masqué par l'équipe KolBase (signalement fondé) : ni affiché, ni compté ; motif communiqué à son auteur.
  hiddenAt     DateTime?
  hiddenReason String?
  // Droit de réponse du prestataire, publié sous l'avis (une seule réponse, modifiable).
  reply     String?
  repliedAt DateTime?
  createdAt  DateTime     @default(now())

  @@index([supplierId])
  @@index([clientId])
}

/**
 * Signalement d'un contenu (registre tenu par l'équipe KolBase) : cible, motif, auteur du signalement (compte ou
 * adresse), décision motivée (contenu retiré ou masqué, sans suite), communiquée à l'auteur du signalement et du contenu.
 */
model Report {
  id            String    @id @default(cuid())
  targetType    String // expert, organisation, evenement, avis
  targetId      String
  targetLabel   String
  reason        String // illicite, inexact, deontologie, donnees, autre
  details       String
  reporterId    String?
  reporter      User?     @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  reporterEmail String?
  status        String    @default("open") // open, closed
  decision      String? // retire, sans_suite
  decisionNote  String?
  handledById   String?
  handledAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([targetType, targetId])
}

/** Journal des e-mails envoyés par KolBase, sans leur contenu : destinataire, objet, statut ; conservé 90 jours. */
model EmailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  status    String // sent, failed, not_configured, reserved
  error     String?
  createdAt DateTime @default(now())

  @@index([to, createdAt])
  @@index([createdAt])
}

/** Logo d'une organisation (PNG, JPEG ou WebP, 500 Ko au plus), conservé en base pour ne pas dépendre du stockage S3. */
model OrganizationBanner {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String
  updatedAt      DateTime     @updatedAt
}

model OrganizationLogo {
  organizationId String       @id
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  data           Bytes
  contentType    String
  updatedAt      DateTime     @updatedAt
}

/**
 * Fiche d'une action de formation (information du public, Qualiopi) : objectifs, public, prérequis, durée, modalités
 * pédagogiques et d'évaluation, accès et délai, accessibilité, tarif et financement, référence DPC, contact.
 */
model TrainingSheet {
  eventId       String   @id
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  objectives    String
  audience      String?
  prerequisites String?
  hours         Float?
  methods       String?
  assessment    String?
  accessDelay   String?
  accessibility String?
  price         String?
  funding       String[] @default([])
  fundingNote   String?
  dpcRef        String?
  contact       String?
  updatedAt     DateTime @updatedAt
}

/** Salle d'un congrès (programme en sessions parallèles). */
model EventRoom {
  id       String        @id @default(cuid())
  eventId  String
  event    Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name     String
  capacity Int?
  position Int           @default(0)
  items    ProgramItem[]

  @@index([eventId])
}

/** Séance du programme : conférence, atelier, symposium d'un partenaire, communications, pause ; salle et horaires. */
model ProgramItem {
  id         String        @id @default(cuid())
  eventId    String
  event      Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roomId     String?
  room       EventRoom?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startsAt   DateTime
  endsAt     DateTime
  kind       String
  title      String
  speakers   String?
  partnerId  String?
  partner    EventPartner? @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  abstractId String?       @unique
  abstract   Abstract?     @relation(fields: [abstractId], references: [id], onDelete: SetNull)
  createdAt  DateTime      @default(now())

  @@index([eventId, startsAt])
}

/**
 * Partenaire d'un événement (industriel, autre organisme) : niveau, montant HT, contreparties (stand, symposium,
 * logo…). Proposé à une organisation présente sur KolBase, il est signé ou décliné par elle ; sinon suivi à la main.
 */
model EventPartner {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  name           String
  level          String
  amountCents    Int?
  counterparts   String?
  status         String        @default("draft") // draft, proposed, signed, declined, paid
  proposedAt     DateTime?
  signedAt       DateTime?
  signedById     String?
  declinedAt     DateTime?
  declineNote    String?
  paidAt         DateTime?
  showLogo       Boolean       @default(true)
  createdAt      DateTime      @default(now())
  items          ProgramItem[]

  @@index([eventId])
  @@index([organizationId])
}

/** Communication soumise à l'appel d'un congrès (résumé), relue par le comité, retenue ou non. */
model Abstract {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title          String
  authors        String
  body           String
  topic          String?
  format         String // oral, poster, indifferent
  status         String           @default("submitted") // submitted, accepted, rejected, withdrawn
  acceptedFormat String?
  decisionNote   String?
  decidedAt      DateTime?
  decidedById    String?
  createdAt      DateTime         @default(now())
  reviews        AbstractReview[]
  item           ProgramItem?

  @@index([eventId])
  @@index([userId])
}

/** Avis d'un relecteur du comité sur une communication (note de 1 à 5). */
model AbstractReview {
  id         String   @id @default(cuid())
  abstractId String
  abstract   Abstract @relation(fields: [abstractId], references: [id], onDelete: Cascade)
  reviewerId String
  score      Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([abstractId, reviewerId])
}

/** Demi-journée d'un événement de plusieurs séquences : émargement à chacune. */
model EventSession {
  id          String       @id @default(cuid())
  eventId     String
  event       Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startsAt    DateTime
  endsAt      DateTime
  attendances Attendance[]

  @@index([eventId, startsAt])
}

/** Émargement d'un participant à une demi-journée : signé par lui (connecté) ou relevé par l'organisateur. */
model Attendance {
  id             String       @id @default(cuid())
  sessionId      String
  session        EventSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  registrationId String
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  signedAt       DateTime     @default(now())
  method         String // self, team
  byId           String?

  @@unique([sessionId, registrationId])
  @@index([registrationId])
}

// Questionnaire de satisfaction d'un participant (une réponse par inscription ; anonyme pour l'organisateur).
model SurveyResponse {
  id             String       @id @default(cuid())
  registrationId String       @unique
  registration   Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  overall        Int          // note globale, 1 à 5
  content        Int?         // contenu scientifique
  logistics      Int?         // organisation et accueil
  // Formation : auto-positionnement sur les objectifs, avant et après (1 à 5).
  selfBefore     Int?
  selfAfter      Int?
  comment        String?
  createdAt      DateTime     @default(now())

  @@index([eventId])
}

// Note d'honoraires établie par un expert pour une convention signée : figée à l'émission (données recopiées).
model FeeNote {
  id              String              @id @default(cuid())
  number          String              // NH-AAAA-NNN, séquentiel par expert et par année
  practitionerId  String
  practitioner    PractitionerProfile @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  projectExpertId String?             @unique
  projectExpert   ProjectExpert?      @relation(fields: [projectExpertId], references: [id], onDelete: SetNull)
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  amountCents     Int                 // HT
  vatBp           Int                 // TVA en points de base (0 en franchise)
  totalCents      Int                 // TTC
  data            Json                // émetteur, destinataire, objet, quantités (figés)
  issuedAt        DateTime            @default(now())

  @@unique([practitionerId, number])
  @@index([organizationId])
}

// Actualités de KolBase (rédigées et publiées par l'équipe depuis /admin).
model Article {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  category    String    @default("Plateforme")
  excerpt     String
  body        String    // texte simple : paragraphes, « ## » intertitres, « - » listes, **gras**, [lien](url)
  coverData   Bytes?
  coverType   String?
  authorId    String?
  publishedAt DateTime? // null : brouillon
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([publishedAt])
}

// Abonnement KolBase d'une organisation (Stripe) : organisation 599 € HT/mois dès la première action engageante,
// prestataire 249 € HT/mois dès le premier devis retenu ; premier mois offert ; gratuités accordées par KolBase.
model Subscription {
  organizationId       String       @id
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan
  interval             BillingInterval    @default(month) // formule annuelle : deux mois offerts
  status               SubscriptionStatus @default(a_activer)
  triggeredAt          DateTime?    // déclenchement (premier devis retenu pour un prestataire)
  triggeredBy          String?
  stripeCustomerId     String?
  stripeSubscriptionId String?      @unique
  trialUsed            Boolean      @default(false)
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean      @default(false)
  exemptUntil          DateTime?    // gratuité accordée par KolBase (pilote, partenaire, démonstration)
  exemptNote           String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
}

// Services additionnels proposés par KolBase sur les événements (catalogue réglé depuis /admin).
model ServiceOffer {
  id          String         @id @default(cuid())
  code        String         @unique // newsletter | reseaux | une | …
  kind        ServiceKind
  includes    String[]       @default([]) // pack : codes des services compris
  label       String
  description String
  priceCents  Int            // HT
  active      Boolean        @default(true)
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  orders      ServiceOrder[]
}

// Commande d'un service sur un événement : réalisée par l'équipe KolBase, facturée une fois réalisée.
model ServiceOrder {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId        String
  event          Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  offerId        String
  offer          ServiceOffer @relation(fields: [offerId], references: [id])
  label          String       // libellé et prix figés à la commande
  priceCents     Int
  brief          String?
  wishedAt       DateTime?
  status         ServiceOrderStatus @default(demandee)
  adminNote      String?
  resultUrl      String?
  orderedById    String
  plannedAt      DateTime?
  doneAt         DateTime?
  invoicedAt     DateTime?
  invoiceRef     String?      // ligne de facture Stripe, ou « hors Stripe »
  trackCode      String?      @unique // lien suivi /r/<code> : clics et inscriptions attribuées
  packLabel      String?      // commandé dans un pack (prix réparti entre les services du pack)
  reportSentAt   DateTime?    // bilan envoyé à l'organisateur
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  campaign       NewsletterCampaign?
  clicks         ServiceClick[]
  registrations  Registration[]

  @@index([organizationId])
  @@index([status])
  @@index([eventId])
}

// Clic sur un lien suivi : visiteur pseudonyme (empreinte non réversible, aucune adresse IP conservée).
model ServiceClick {
  id        String       @id @default(cuid())
  orderId   String
  order     ServiceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  visitor   String
  createdAt DateTime     @default(now())

  @@index([orderId])
}

// Lettre d'information envoyée aux membres qui ont accepté de la recevoir.
model NewsletterCampaign {
  id          String        @id @default(cuid())
  orderId     String?       @unique
  order       ServiceOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subject     String
  body        String
  recipients  Int           @default(0)
  sentAt      DateTime?
  createdById String
  createdAt   DateTime      @default(now())
}

// Abonnements et services : valeurs en minuscules, identiques à l'ancien texte libre (migration sans réécriture).
enum SubscriptionPlan {
  organisation
  prestataire
}

enum BillingInterval {
  month
  year
}

enum SubscriptionStatus {
  a_activer
  essai
  active
  impayee
  resiliee
}

/// newsletter : lettre aux membres ; social : réseaux sociaux ; une : accueil ; pack : plusieurs services ; autre.
enum ServiceKind {
  newsletter
  social
  une
  pack
  autre
}

enum ServiceOrderStatus {
  demandee
  planifiee
  realisee
  refusee
  annulee
}

/// Suivi des tâches planifiées (POST /api/taches) : dernière exécution et dernière réussite, affichées dans /admin.
model TaskRun {
  name      String    @id
  startedAt DateTime
  okAt      DateTime?
  error     String?
  result    Json?
}

// Tentative comptée par le limiteur de débit (connexion, inscription, réinitialisation, 2FA, assistant…) : clé hachée,
// date. Stockée en base pour survivre aux déploiements ; purgée après 24 h par la tâche planifiée.
model RateLimitHit {
  id  String   @id @default(cuid())
  key String
  at  DateTime @default(now())

  @@index([key, at])
}

// Événement Stripe déjà traité : une notification renvoyée par Stripe (même identifiant) n'est pas appliquée deux fois.
model StripeEvent {
  id         String   @id // identifiant de l'événement chez Stripe (evt_…)
  type       String
  receivedAt DateTime @default(now())
}

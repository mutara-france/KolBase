{
  "name": "kolbase",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit",
    "deploy:prepare": "sh scripts/predeploy.sh",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/parcours.mjs",
    "test:a11y": "node tests/e2e/accessibilite.mjs",
    "test:affichage": "node tests/e2e/affichage.mjs",
    "db:purge-demo": "tsx scripts/purge-demo.ts",
    "deadcode": "knip",
    "test:coverage": "vitest run --coverage",
    "check": "biome ci ."
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@types/qrcode": "^1.5.6",
    "lucide-react": "^1.66.0",
    "next": "^16.4.4",
    "nodemailer": "^10.3.1",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "dotenv": "^18.0.9",
    "knip": "^6.44.1",
    "mailparser": "^3.14.1",
    "playwright": "^1.64.1",
    "prisma": "^7.10.1",
    "smtp-server": "^3.21.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }

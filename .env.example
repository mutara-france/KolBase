# Copier en .env pour le développement local
DATABASE_URL="postgresql://kolbase:kolbase@localhost:5432/kolbase"
# Secret de session (générer avec : openssl rand -base64 32)
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# Administrateurs de la plateforme KolBase (page /admin), e-mails séparés par des virgules
PLATFORM_ADMIN_EMAILS=""
# Connexion ORCID (facultatif)
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
# E-mails : sans SMTP_URL, leur contenu est écrit dans le terminal au lieu d'être envoyé
SMTP_URL=""
MAIL_FROM="KolBase <no-reply@kolbase.fr>"
# Documents des dossiers (stockage S3 compatible, compartiment privé) ; S3_FORCE_PATH_STYLE=1 pour MinIO
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Signature électronique des conventions (facultatif, Yousign API v3). Sans YOUSIGN_API_KEY : signature sur papier.
# YOUSIGN_API_URL : production par défaut (https://api.yousign.app/v3) ; bac à sable : https://api-sandbox.yousign.app/v3
# YOUSIGN_WEBHOOK_SECRET : secret du webhook déclaré chez Yousign vers <APP_URL>/api/signature/webhook
YOUSIGN_API_KEY=""
YOUSIGN_API_URL=""
YOUSIGN_WEBHOOK_SECRET=""

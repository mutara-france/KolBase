# Copier en .env pour le développement local
DATABASE_URL="postgresql://kolbase:kolbase@localhost:5432/kolbase"
# Secret de session (générer avec : openssl rand -base64 32)
AUTH_SECRET=""
APP_URL="http://localhost:3000"
# Administrateurs de la plateforme KolBase (page /admin), e-mails séparés par des virgules
PLATFORM_ADMIN_EMAILS=""
# Connexion ORCID (facultatif)
ORCID_CLIENT_ID=""
ORCID_CLIENT_SECRET=""
# E-mails : sans SMTP_URL, leur contenu est écrit dans le terminal au lieu d'être envoyé
SMTP_URL=""
MAIL_FROM="KolBase <no-reply@kolbase.fr>"
